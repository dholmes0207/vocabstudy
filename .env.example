# Copy to .env and fill in. Only the server reads these.

# Port for the Express API (and static serving in production).
PORT=8787

# REQUIRED in production: a long random secret for signing auth tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives (dev). For production Postgres, see roadmap.
DB_PATH=./server/data.sqlite

# Server-side OpenAI key for the AI tutor (students never see this).
# Optional if you add providers via the Admin UI instead.
OPENAI_API_KEY=
OPENAI_MODEL=o4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Max AI questions per user per day.
AI_DAILY_LIMIT=100
