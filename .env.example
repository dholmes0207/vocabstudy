# Frontend build-time env (Vite). These are PUBLIC (shipped to the browser) —
# safe because Supabase Row Level Security protects the data. On Cloudflare
# Pages, set these under Settings → Environment variables (Production + Preview).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: server-side SECRETS (OpenAI key, Supabase service role) are NOT here.
# They go to Cloudflare Pages Functions secrets — see .dev.vars.example / docs/DEPLOY.md.
