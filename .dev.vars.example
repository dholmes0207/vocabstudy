# Secrets for Cloudflare Pages Functions (server-side only — NEVER shipped to
# the browser). Copy to `.dev.vars` for local `npm run pages:dev`, and set the
# same as Encrypted environment variables in the Cloudflare Pages dashboard.

# OpenAI (AI tutor). The key lives only here / on Cloudflare — students never see it.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=o4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Độ "suy nghĩ" của o4-mini: low | medium | high. Cao hơn = thông minh hơn nhưng chậm/đắt hơn.
OPENAI_REASONING_EFFORT=medium
# Số lượt hỏi trợ lý AI mỗi học sinh mỗi ngày (0 = không giới hạn). Mặc định 30.
# Cần chạy supabase/schema.sql (bảng ai_usage + hàm bump_ai_usage) thì mới đếm được;
# chưa chạy thì trợ lý vẫn hoạt động bình thường, chỉ là chưa bị chặn.
AI_DAILY_LIMIT=30

# Supabase (for token verification + admin operations).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
