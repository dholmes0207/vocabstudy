      "phrases": [
        {
          "id": 3001,
          "en": "你好！",
          "read": "Nǐ hǎo!",
          "vi": "Xin chào!",
          "note": "Chào người lớn tuổi hay khách hàng thì nói 您好 (nín hǎo) cho lễ phép."
        },
        {
          "id": 3002,
          "en": "认识​你​很​高兴。",
          "read": "Rènshi nǐ hěn gāoxìng.",
          "vi": "Rất vui được làm quen với bạn."
        },
        {
          "id": 3003,
          "en": "我​叫​阮​兰，​你​叫​什么​名字？",
          "read": "Wǒ jiào Ruǎn Lán, nǐ jiào shénme míngzi?",
          "vi": "Mình tên là Nguyễn Lan, bạn tên gì?",
          "note": "Tên tiếng Việt thường có chữ Hán tương ứng: họ Nguyễn là 阮 (Ruǎn), Lan là 兰 (Lán)."
        },
        {
          "id": 3004,
          "en": "你​是​哪​国​人？",
          "read": "Nǐ shì nǎ guó rén?",
          "vi": "Bạn là người nước nào?",
          "note": "Đáp: 我是越南人。"
        },
        {
          "id": 3005,
          "en": "我​是​越南​人。",
          "read": "Wǒ shì Yuènán rén.",
          "vi": "Mình là người Việt Nam."
        },
        {
          "id": 3006,
          "en": "好久​不​见！",
          "read": "Hǎojiǔ bú jiàn!",
          "vi": "Lâu lắm không gặp!",
          "note": "不 đọc thành bú khi đứng trước thanh 4 (见 jiàn)."
        },
        {
          "id": 3007,
          "en": "最近​怎么样？",
          "read": "Zuìjìn zěnmeyàng?",
          "vi": "Dạo này thế nào?",
          "note": "Hỏi người quen. Đáp: 挺好的 (khá ổn)."
        },
        {
          "id": 3008,
          "en": "再见！",
          "read": "Zàijiàn!",
          "vi": "Tạm biệt!",
          "note": "Bạn bè hay nói 拜拜 (bái bái)."
        },
        {
          "id": 3009,
          "en": "明天​见！",
          "read": "Míngtiān jiàn!",
          "vi": "Mai gặp lại nhé!"
        }
      ]
    },
    {
